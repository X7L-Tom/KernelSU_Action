# URL kode sumber kernel Redmi 10C (Contoh repositori komunitas stabil)
KERNEL_SOURCE=https://github.com/r0ddty/kernel_xiaomi_fog
KERNEL_SOURCE_BRANCH=main

# Nama file defconfig bawaan Redmi 10C
KERNEL_CONFIG=vendor/fog-perf_defconfig

# Nama hasil file akhir yang sesuai dengan struktur device tree perangkat Anda
KERNEL_IMAGE_NAME=Image.gz-dtb

# Versi compiler Clang (Gunakan versi r510928 untuk stabilitas kernel 4.19)
CLANG_BRANCH=main-kernel-build-2024
CLANG_VERSION=r510928

# Setelan Tambahan Kompilasi
EXTRA_CMDS=LD=ld.lld

# PILIHAN VARIAN ROOT (Ganti ke 'kernelsu-next' jika ingin memakai versi Next)
KSU_VARIANT=kernelsu-next
KSU_REF=legacy

# Fitur Tambahan Keamanan & Mount (Opsional namun direkomendasikan)
ENABLE_PATH_UMOUNT=true
ADD_OVERLAYFS_CONFIG=true
DISABLE_CC_WERROR=true
